{
  "version": 2,
  "builds": [
    { "src": "api/analyze.js", "use": "@vercel/node" },
    { "src": "api/chat.js",    "use": "@vercel/node" },
    { "src": "api/prices.js",  "use": "@vercel/node" },
    { "src": "index.html",     "use": "@vercel/static" },
    { "src": "manifest.json",  "use": "@vercel/static" },
    { "src": "sw.js",          "use": "@vercel/static" },
    { "src": "icons/**",       "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/analyze", "dest": "/api/analyze.js" },
    { "src": "/api/chat",    "dest": "/api/chat.js" },
    { "src": "/api/prices",  "dest": "/api/prices.js" },
    { "src": "/sw.js",       "dest": "/sw.js",        "headers": { "Cache-Control": "no-cache", "Content-Type": "application/javascript" }},
    { "src": "/manifest.json","dest": "/manifest.json","headers": { "Content-Type": "application/manifest+json" }},
    { "src": "/icons/(.*)",  "dest": "/icons/$1" },
    { "src": "/(.*)",        "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=*, microphone=()" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
